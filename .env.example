# Copy to .env (never commit .env), then append secrets:
#   cp .env.example .env && ./gen-secrets.sh >> .env && chmod 600 .env

# Public URL users open. Local try: http://localhost:6767.
# Production: the https:// URL served by your TLS reverse proxy.
FRONTEND_URL=http://localhost:6767
# Port on 127.0.0.1 that your browser (or TLS reverse proxy) connects to.
HOST_PORT=6767
# Proxy hops in front of the backend: 1 = just the frontend's nginx (local try),
# 2 = your TLS proxy + the frontend's nginx (production).
TRUST_PROXY=1

# --- Authentication --------------------------------------------------------
# local:          email/password accounts managed in ExcaliDash.
#                 First start: open the app, choose "enable authentication", and create
#                 the admin with the one-time setup code from `docker compose logs backend`.
#                 Do this before anyone else can reach the page.
# oidc_enforced:  sign-in only through Google (fill in the OIDC_* values below).
AUTH_MODE=local

# --- Google sign-in (only for AUTH_MODE=oidc_enforced) ---------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Set the OAuth consent screen's user type to "Internal" so only accounts in your
# Google Workspace can sign in. With "External", ANY Google account gets an account
# here (JIT provisioning) unless you set OIDC_JIT_PROVISIONING=false.
OIDC_PROVIDER_NAME=Google
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must also be listed as an authorized redirect URI on the Google client.
OIDC_REDIRECT_URI=http://localhost:6767/api/auth/oidc/callback

# Google ID tokens carry no groups claim, so admin rights can't come from groups:
# the first person to sign in becomes admin. Sign in yourself right after the
# first start. With an IdP that sends groups (Keycloak, Authentik, Entra ID), set
# OIDC_ADMIN_GROUPS and OIDC_FIRST_USER_ADMIN=false, and update egress/filter.
OIDC_FIRST_USER_ADMIN=true
OIDC_ADMIN_GROUPS=
OIDC_JIT_PROVISIONING=true

# --- Secrets: generated by ./gen-secrets.sh, appended below ---------------
# JWT_SECRET=
# CSRF_SECRET=
# API_KEY_HASH_PEPPER=   (never change once API keys exist; back it up)
